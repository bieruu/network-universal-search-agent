NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Self-service sign-up gate. Backend scan quota is 10/hour PER USER, so every
# new account multiplies Shodan cost. Unset = closed under NODE_ENV=production,
# open in dev. Ops can flip this without a code change.
SIGNUP_ENABLED=
# Optional allowlist. Empty = any email may register. Entries may be
# user@example.com, @example.com, *@example.com, or a bare example.com.
# Leave empty to rely on SIGNUP_ENABLED alone.
SIGNUP_EMAIL_ALLOWLIST=
# Optional. Reverse-proxy IPs / CIDR ranges that sit in front of this app and
# append to x-forwarded-for. Better Auth trusts ONLY single-value IP headers, so
# behind a proxy it cannot resolve a client IP and keys every caller onto one
# shared rate-limit bucket — 3 sign-ups / 10s for everyone. Listing the proxy
# hops restores per-client buckets.
# Server-side only, never NEXT_PUBLIC_: these ranges describe internal topology.
# Leave empty unless you know the address of the hop nearest the app. Vercel
# does not publish edge ranges for this, so on Vercel this usually stays empty.
# Ranges covering every address (0.0.0.0/0, ::/0, bare 0.0.0.0) are rejected:
# they would trust the client-supplied leftmost x-forwarded-for token and let
# anyone mint a fresh bucket per request.
BETTER_AUTH_TRUSTED_PROXIES=
# --- Password reset -------------------------------------------------------
# All three are OPTIONAL. With none of them set the app boots normally and the
# forgot-password page still renders and still answers identically for every
# address — it just cannot actually send anything. Reset emails are OFF unless
# RESEND_API_KEY is set; the server logs one clear warning per process saying so.
#
# RESEND_API_KEY is a SECRET (https://resend.com/api-keys). Treat it exactly
# like SHODAN_API_KEY: env only, never committed, never logged, never returned
# to the browser. Server-side only — do NOT prefix it with NEXT_PUBLIC_.
RESEND_API_KEY=
# The From header on the reset email. Must be a sender you have verified in
# Resend. Falls back to "Universal Search <noreply@example.com>", which most
# providers will reject — set it before enabling reset.
AUTH_FROM_EMAIL=Universal Search <noreply@your-domain.com>
# Optional. Milliseconds to wait on the mail send before giving up (default
# 10000). Better Auth awaits this call, so a hung provider would otherwise hold
# the request open and stall the shared rate-limit bucket.
RESET_EMAIL_TIMEOUT_MS=10000
DATABASE_URL=postgresql://owner:your-own-password-here@localhost:5432/osint
BACKEND_URL=http://localhost:8000
