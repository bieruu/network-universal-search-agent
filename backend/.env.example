SHODAN_API_KEY=your-shodan-key
DATABASE_URL=sqlite+aiosqlite:///./data/cache.db
# Postgres: postgresql+asyncpg://osint:osint@localhost:5432/osint
SQLITE_PATH=./data/cache.db
# sqlite (local file) or postgres (managed DB, required in prod without a volume)
CACHE_BACKEND=sqlite
BETTER_AUTH_SECRET=change-me-32-chars-min
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
SCAN_TIMEOUT_SHODAN=12
SCAN_TIMEOUT_CRTSH=15
SCAN_TIMEOUT_WHOIS=10
RATE_LIMIT_PER_HOUR=10
