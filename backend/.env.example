SHODAN_API_KEY=your-shodan-key
POSTGRES_DB=osint
POSTGRES_USER=owner
POSTGRES_PASSWORD=your-own-password-here
# `+asyncpg` is required: the backend opens the DB with create_async_engine()
# (app/db/session.py) and asyncpg is the only Postgres driver installed;
# `psycopg` is not in requirements, so plain `postgresql://` fails at boot.
DATABASE_URL=postgresql+asyncpg://owner:your-own-password-here@localhost:5432/osint
SQLITE_PATH=./data/cache.db
# sqlite (local file) or postgres (managed DB, required in prod without a volume)
CACHE_BACKEND=sqlite
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional: dedicated token for `Authorization: Bearer ...` machine access.
# Must NOT be the same as BETTER_AUTH_SECRET. Leave empty to disable Bearer auth.
SERVICE_TOKEN=
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
SCAN_TIMEOUT_SHODAN=12
SCAN_TIMEOUT_CRTSH=15
SCAN_TIMEOUT_WHOIS=10
SCAN_TIMEOUT_NVD=12
NVD_API_KEY=
NVD_MAX_CPES=5
NVD_CVES_PER_CPE=20
NVD_PAGE_SIZE=100
# Per-account scans per rolling hour. PRODUCTION REQUIRES this to be present in the
# process environment (a real env var, not only a .env file baked into the image)
# and at most 5, or the backend refuses to boot — an unset quota is a silent budget
# decision on a paid Shodan key. Raise it by buying more Shodan credit, not by
# editing PRODUCTION_RATE_LIMIT_CEILING in app/core/config.py.
RATE_LIMIT_PER_HOUR=5
# Opt-in instance-wide cost backstop: max *admitted* scans per rolling 24h across
# all accounts, counted in hourly buckets. 0 = disabled (default). The per-account
# quota cannot express a budget for the shared key — N accounts each inside their
# own quota still add up.
RATE_LIMIT_DAILY_TOTAL=0
# Absolute ceiling on live per-user rate-limit bucket keys. The periodic sweep only
# bounds growth relative to arrival rate, not absolute size. At the cap, an unknown
# key is refused with 429 until the next sweep reclaims space (fail closed: no
# bucket is evicted, so no already-limited account gains quota).
RATE_LIMIT_MAX_KEYS=10000
# Per-account hourly quota for the v2 analysis capabilities that cost NO Shodan
# credit (DNS, TLS, headers/cookies, redirects, sitemap, contacts, EXIF, phone).
# Deliberately separate from RATE_LIMIT_PER_HOUR: that constant is a billing
# decision about the shared paid key, so spending it on free work would both burn
# money budget and let a cheap endpoint exhaust a user's scan allowance. Shares the
# memory ceiling and sweep above, not the quota or the keyspace.
FREE_RATE_LIMIT_PER_HOUR=20
# TESTING ONLY — subjects exempt from BOTH rate-limit buckets, so load/QA work is
# not stopped by our own 429 before it reaches the provider limits.
# Comma-separated exact `require_user()` subjects. The intended value is
# `user:service`, which is returned ONLY for `Authorization: Bearer <SERVICE_TOKEN>`
# (compared with hmac.compare_digest) — a secret that never reaches a browser.
# A signed-in user's subject is always `user:<db-id>`, so a stolen cookie or an
# XSS can never become an unlimited draw on the paid Shodan key. Leave EMPTY in
# production unless a QA pass is genuinely running; every exempt call is logged
# at WARNING so a forgotten setting is visible.
# An exempt call is not merely uncapped: it creates no bucket and does NOT bill
# RATE_LIMIT_DAILY_TOTAL, so a load test cannot drain the cost backstop.
# This does NOT raise provider limits (OTX 100/h per IP, Leak-Lookup 10/day) —
# those stay shared across all users.
RATE_LIMIT_EXEMPT_SUBJECTS=

# --- v2 optional sources ---------------------------------------------------
# Every one of these is OPTIONAL. A blank value is a supported state, not a
# misconfiguration: the source reports `not_configured` and the dashboard says
# why it is dark, instead of pretending it found nothing.
SCAN_TIMEOUT_DNS=10

# Leak-Lookup. The key is free but REQUIRED (the TODO's "public, no key" is wrong),
# the free tier is capped at 10 queries/day, and its ToS restricts queries to
# targets the operator is authorised to search — so wiring it to arbitrary
# signed-in users is an operator decision. Leave empty to ship it dark.
LEAKLOOKUP_API_KEY=
SCAN_TIMEOUT_LEAKLOOKUP=12

# URLScan.io read-only search. Needs NO key (30 req/min per IP anonymously); a key
# only unlocks verdicts and higher quotas. Free-tier history is capped upstream at
# 30 days / 100 results per page, so the UI must not promise "full history".
URLSCAN_API_KEY=
SCAN_TIMEOUT_URLSCAN=12

# VirusTotal (https://www.virustotal.com). Free key is enough for domain/IP/URL
# lookups; the file-upload endpoint and deeper analysis need a paid plan. Leave
# empty to ship it dark.
VIRUSTOTAL_API_KEY=
SCAN_TIMEOUT_VIRUSTOTAL=12

# AlienVault OTX (https://otx.alienvault.com). OPTIONAL: OTX serves its indicator
# and pulse endpoints with no key at all, at a lower anonymous rate limit. Set
# this only to raise that limit — the source works without it.
OTX_API_KEY=
SCAN_TIMEOUT_OTX=12
