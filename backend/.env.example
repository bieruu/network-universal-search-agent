SHODAN_API_KEY=your-shodan-key
POSTGRES_DB=osint
POSTGRES_USER=owner
POSTGRES_PASSWORD=your-own-password-here
# `+asyncpg` is required: the backend opens the DB with create_async_engine()
# (app/db/session.py) and asyncpg is the only Postgres driver installed;
# `psycopg` is not in requirements, so plain `postgresql://` fails at boot.
DATABASE_URL=postgresql+asyncpg://owner:your-own-password-here@localhost:5432/osint
SQLITE_PATH=./data/cache.db
# sqlite (local file) or postgres (managed DB, required in prod without a volume)
CACHE_BACKEND=sqlite
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional: dedicated token for `Authorization: Bearer ...` machine access.
# Must NOT be the same as BETTER_AUTH_SECRET. Leave empty to disable Bearer auth.
SERVICE_TOKEN=
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
SCAN_TIMEOUT_SHODAN=12
SCAN_TIMEOUT_CRTSH=15
SCAN_TIMEOUT_WHOIS=10
SCAN_TIMEOUT_NVD=12
NVD_API_KEY=
NVD_MAX_CPES=5
NVD_CVES_PER_CPE=20
NVD_PAGE_SIZE=100
# Per-account scans per rolling hour. PRODUCTION REQUIRES this to be present in the
# process environment (a real env var, not only a .env file baked into the image)
# and at most 5, or the backend refuses to boot — an unset quota is a silent budget
# decision on a paid Shodan key. Raise it by buying more Shodan credit, not by
# editing PRODUCTION_RATE_LIMIT_CEILING in app/core/config.py.
RATE_LIMIT_PER_HOUR=5
# Opt-in instance-wide cost backstop: max *admitted* scans per rolling 24h across
# all accounts, counted in hourly buckets. 0 = disabled (default). The per-account
# quota cannot express a budget for the shared key — N accounts each inside their
# own quota still add up.
RATE_LIMIT_DAILY_TOTAL=0
# Absolute ceiling on live per-user rate-limit bucket keys. The periodic sweep only
# bounds growth relative to arrival rate, not absolute size. At the cap, an unknown
# key is refused with 429 until the next sweep reclaims space (fail closed: no
# bucket is evicted, so no already-limited account gains quota).
RATE_LIMIT_MAX_KEYS=10000
